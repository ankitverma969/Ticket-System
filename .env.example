# Server Configuration
PORT=8080
# API Base URL for Swagger/OpenAPI interactive testing (Default: http://localhost:8080)
# In production/EC2, set to your public endpoint, e.g. http://3.238.130.1:8080
API_BASE_URL=http://localhost:8080

# MongoDB Configuration (for future stages)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ticket_system

# JWT Configuration (for future stages)
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRATION=24h
